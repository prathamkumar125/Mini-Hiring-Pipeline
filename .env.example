# Copy this file to .env and change only the values you need.
# The .env file is ignored by Git.

# SQLite database filename or absolute path.
DATABASE_PATH=hiring_pipeline.db

# A model already pulled through Ollama, for example: ollama pull qwen2.5-coder:1.5b
OLLAMA_MODEL=qwen2.5-coder:1.5b

# FastAPI base URL used by the Streamlit UI.
API_URL=http://127.0.0.1:8000
